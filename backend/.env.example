# ── Database ─────────────────────────────────────────────────────────────────
# Get from Supabase dashboard → Project Settings → Database → Connection string
# Use the "URI" format with asyncpg driver
DATABASE_URL=postgresql+asyncpg://postgres:<password>@<host>:5432/postgres

# ── Redis ────────────────────────────────────────────────────────────────────
# Get from Upstash console → Redis database → Connect → REST URL
# Use rediss:// for TLS (required by Upstash)
REDIS_URL=rediss://:<password>@<host>:6379

# ── Qdrant ───────────────────────────────────────────────────────────────────
# Get from cloud.qdrant.io → Cluster → API Keys
QDRANT_URL=https://<cluster-id>.us-east4-0.gcp.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key

# ── Security ─────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
SECRET_KEY=your-64-char-hex-secret-key
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-key-here

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Options: ollama | groq | anthropic | openai
LLM_PROVIDER=groq

# Groq (free — sign up at console.groq.com)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.1-70b-versatile

# Ollama (local, free — install from ollama.com)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Anthropic (optional, paid)
ANTHROPIC_API_KEY=

# OpenAI (optional, paid)
OPENAI_API_KEY=

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Get from console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Microsoft OAuth ───────────────────────────────────────────────────────────
# Get from portal.azure.com → App registrations
MICROSOFT_CLIENT_ID=your-azure-app-client-id
MICROSOFT_CLIENT_SECRET=your-azure-app-client-secret
MICROSOFT_TENANT_ID=common

# ── WhatsApp ─────────────────────────────────────────────────────────────────
# Get from developers.facebook.com → WhatsApp → API Setup
WHATSAPP_VERIFY_TOKEN=any-random-string-you-choose
WHATSAPP_ACCESS_TOKEN=your-meta-permanent-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id

# ── CORS / URLs ───────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
